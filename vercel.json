{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/.next/standalone/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_GRAPHQL_URL": "https://game-lobby-kou8ncbmo-felix-cobbinahs-projects.vercel.app/graphql"
  }
}
